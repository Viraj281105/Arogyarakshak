# ──────────────────────────────────────────────────────────────────────
# ArogyaRakshak — Environment Variables
# Copy to .env and fill in real values before running docker-compose.
# ──────────────────────────────────────────────────────────────────────

# Groq LLM — default model (never use deprecated llama3-70b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Groq API key. REQUIRED for LLM-backed extraction and appeal drafting.
# Leave blank to run fully offline: Kadi extraction falls back to regex heuristics and
# BillNyay returns a templated appeal letter. Both are lower quality, and the API reports
# "groq_configured": false on GET /health so the degraded mode is visible.
GROQ_API_KEY=

# PostgreSQL
POSTGRES_USER=arogyarakshak
POSTGRES_PASSWORD=arogyarakshak
POSTGRES_DB=arogyarakshak
DATABASE_URL=postgresql://arogyarakshak:arogyarakshak@postgres:5432/arogyarakshak

# Clinical review & safety governance (ADR-011).
# Operator secret for safety-board seating, verification attempts and demo seeding.
# Leave EMPTY to disable those actions entirely. Use a long random value if you set it.
CLINICAL_GOVERNANCE_ADMIN_KEY=
# Demo fixtures (demo reviewers, DEMO_VERIFIED status, demo safety rules).
# NEVER true in a real deployment.
CLINICAL_DEMO_MODE=false
# Deployment profile. APP_ENV=production refuses to start while any development default
# remains (demo mode, default signing secret or DB credentials, wildcard CORS, create_all).
APP_ENV=development
# Database schema at start-up (ADR-020): migrate | none | create_all (legacy, local only).
SCHEMA_MANAGEMENT=migrate
# text (local) or json (log collectors). Every line carries the request id.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Demo scenario loaders read the synthetic documents from here (empty = auto-detect).
DEMO_DOCUMENTS_DIR=
# OCR segments below this confidence go to human transcription instead of being trusted.
OCR_LOW_CONFIDENCE_THRESHOLD=0.5
# OCR languages (comma separated: en, hi, mr). Default en = unchanged behaviour; hi,mr,en enables Devanagari.
OCR_LANGUAGES=en
# Bounds on OCR work per PDF (defaults shown): pages OCR'd (max 10), seconds, queue wait, pixels per page.
# OCR_MAX_PAGES=3
# OCR_DOCUMENT_BUDGET_SECONDS=120
# OCR_QUEUE_TIMEOUT_SECONDS=30
# OCR_PDF_MAX_PIXELS=10000000
# OCR model weights: baked in at image build (scripts/fetch_ocr_models.py), never fetched while serving.
# EASYOCR_MODULE_PATH=/opt/easyocr
# Independent safety-board approvals required before a rule can be activated.
SAFETY_RULE_REQUIRED_APPROVALS=1

# User accounts (ADR-026). Sessions live in the database (hash only).
SESSION_LIFETIME_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=120
# Web session cookie: httpOnly, Secure, SameSite=Strict (__Host-arogya_session). Set false ONLY for
# plain-http local development; refused with APP_ENV=production.
SESSION_COOKIE_SECURE=true
# Origins allowed to send cookie-authenticated writes and browser logins (empty = explicit CORS_ORIGINS).
# A cross-origin web client also needs an explicit CORS_ORIGINS for the browser to send the cookie.
AUTH_TRUSTED_ORIGINS=
# stdlib scrypt password hashing (N=2^15, r=8, p=3; ~32 MiB per hash).
PASSWORD_SCRYPT_N=32768
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=3
# Stricter per-IP bucket for register/login/verification/reset, and the per-account sign-in pause.
AUTH_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
ACCOUNT_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Email delivery is an open decision (new network boundary): "disabled" is the only value.
MAIL_TRANSPORT=disabled

# Kadi entity resolution (#30, ADR-006): optional IndicSBERT cross-lingual signal.
# Off by default. When true, the ~950 MB model downloads from the Hugging Face Hub on
# first use (needs the kadi[semantic] extra, which the API image installs).
KADI_SEMANTIC_MATCHING=false

# HMAC key for appeal-PDF integrity signatures (#66). The built-in default is insecure:
# set a long random value for any real deployment. Not a digital signature certificate (DSC).
# DOCUMENT_SIGNING_SECRET=  (left commented: an empty value would override the default with an empty key)

# LLM reliability (ADR-024). Read from the process environment by kadi.llm; Docker Compose
# forwards them. Defaults keep the old behaviour except retries + circuit breaker.
# Second Groq model tried when GROQ_MODEL fails (empty = none; deprecated models refused).
GROQ_FALLBACK_MODEL=
LLM_MAX_ATTEMPTS=3
# Overall limit for one LLM call across all attempts and the fallback model (> 0).
LLM_TOTAL_DEADLINE_SECONDS=20
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_RECOVERY_SECONDS=30
# Token budget per BillNyay pipeline run (one appeal/grievance draft, 0 = unlimited).
# Not a lifetime per-case budget; Kadi extraction is not budgeted.
LLM_CASE_TOKEN_BUDGET=0
# In-memory response cache: off by default; read ADR-024's residual-risk note first.
LLM_CACHE_ENABLED=false
# Shadow runs of a candidate model (agreement counters only). Off by default.
LLM_SHADOW_ENABLED=false
LLM_SHADOW_MODEL=
# Observability (WS1, ADR-023; docs/operations/observability.md). All self-hosted, nothing leaves the machine.
# Prometheus metrics at GET /metrics (internal). Unset = on in development, off under APP_ENV=production.
# METRICS_ENABLED=true
# OpenTelemetry tracing (off by default in the app; the observability compose override turns it on for the
# api container unless you set OTEL_ENABLED here, so these stay commented).
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=arogyarakshak-api
# OTEL_TRACES_SAMPLER_RATIO=1.0
# Grafana admin password for docker-compose.observability.yml. The development default is
# refused when APP_ENV=production; set a unique value of 12+ characters for anything real.
# GRAFANA_ADMIN_PASSWORD=arogyarakshak-dev-only
