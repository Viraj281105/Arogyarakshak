# ──────────────────────────────────────────────────────────────────────
# ArogyaRakshak — Environment Variables
# Copy to .env and fill in real values before running docker-compose.
# ──────────────────────────────────────────────────────────────────────

# Groq LLM — default model (never use deprecated llama3-70b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Groq API key. REQUIRED for LLM-backed extraction and appeal drafting.
# Leave blank to run fully offline: Kadi extraction falls back to regex heuristics and
# BillNyay returns a templated appeal letter. Both are lower quality, and the API reports
# "groq_configured": false on GET /health so the degraded mode is visible.
GROQ_API_KEY=

# PostgreSQL
POSTGRES_USER=arogyarakshak
POSTGRES_PASSWORD=arogyarakshak
POSTGRES_DB=arogyarakshak
DATABASE_URL=postgresql://arogyarakshak:arogyarakshak@postgres:5432/arogyarakshak

# Clinical review & safety governance (ADR-011).
# Operator secret for safety-board seating, verification attempts and demo seeding.
# Leave EMPTY to disable those actions entirely. Use a long random value if you set it.
CLINICAL_GOVERNANCE_ADMIN_KEY=
# Demo fixtures (demo reviewers, DEMO_VERIFIED status, demo safety rules).
# NEVER true in a real deployment.
CLINICAL_DEMO_MODE=false
# Deployment profile. APP_ENV=production refuses to start with CLINICAL_DEMO_MODE=true.
APP_ENV=development
# Demo scenario loaders read the synthetic documents from here (empty = auto-detect).
DEMO_DOCUMENTS_DIR=
# OCR segments below this confidence go to human transcription instead of being trusted.
OCR_LOW_CONFIDENCE_THRESHOLD=0.5
# Independent safety-board approvals required before a rule can be activated.
SAFETY_RULE_REQUIRED_APPROVALS=1

# Kadi entity resolution (#30, ADR-006): optional IndicSBERT cross-lingual signal.
# Off by default. When true, the ~950 MB model downloads from the Hugging Face Hub on
# first use (needs the kadi[semantic] extra, which the API image installs).
KADI_SEMANTIC_MATCHING=false
