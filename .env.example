# ──────────────────────────────────────────────────────────────────────
# ArogyaRakshak — Environment Variables
# Copy to .env and fill in real values before running docker-compose.
# ──────────────────────────────────────────────────────────────────────

# Groq LLM — default model (never use deprecated llama3-70b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL
POSTGRES_USER=arogyarakshak
POSTGRES_PASSWORD=arogyarakshak
POSTGRES_DB=arogyarakshak
DATABASE_URL=postgresql://arogyarakshak:arogyarakshak@postgres:5432/arogyarakshak
