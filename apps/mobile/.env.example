# ArogyaRakshak Mobile Configuration
# Android Emulator uses 10.0.2.2 to point to host machine localhost:8000
# iOS Simulator or Web uses http://localhost:8000
# Physical Device on LAN: use your machine's LAN IP e.g. http://192.168.1.100:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Optional mock flags for device testing without backend
EXPO_PUBLIC_USE_MOCK_DATA=false
